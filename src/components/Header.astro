---
import { withBase } from '../utils/urls';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigation = [
  { label: 'Home', href: withBase() },
  { label: 'Magazine', href: withBase('blog/') },
  { label: 'Autori', href: withBase('autori/') },
  { label: 'Community', href: withBase('community/') },
  { label: 'Risorse', href: withBase('risorse/') },
];

function isCurrent(href: string): boolean {
  if (href === withBase()) return currentPath === href || currentPath === href.slice(0, -1);
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase()} aria-label="Fantascienza e dintorni, homepage">
      <span class="brand-mark" aria-hidden="true"><span></span></span>
      <span>Fantascienza<br />e dintorni</span>
    </a>
    <nav class="primary-nav" aria-label="Navigazione principale">
      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="button button-compact" href={withBase('community/')}>
      Il progetto
      <span aria-hidden="true">→</span>
    </a>
  </div>
</header>
