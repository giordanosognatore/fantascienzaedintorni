---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={['telegram-cta', { 'telegram-cta-compact': compact }]} aria-labelledby={compact ? 'telegram-title-compact' : 'telegram-title'}>
  <div>
    <p class="eyebrow">La community è su Telegram</p>
    <h2 id={compact ? 'telegram-title-compact' : 'telegram-title'}>
      Il sito conserva le idee.<br />Il gruppo le mette in movimento.
    </h2>
    <p>Entra in Passione Fantascienza per parlare di libri, cinema, serie e futuri possibili.</p>
  </div>
  <a class="button" href="https://t.me/fantascienza1" target="_blank" rel="noreferrer">
    Continua la conversazione <span aria-hidden="true">↗</span>
  </a>
</aside>
