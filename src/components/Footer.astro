---
import { withBase } from '../utils/urls';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="footer-brand" href={withBase()}>Fantascienza e dintorni</a>
      <p>Storie, visioni e idee sui futuri possibili.</p>
    </div>
    <nav aria-label="Link nel piè di pagina">
      <a href={withBase('blog/')}>Magazine</a>
      <a href={withBase('community/')}>Community</a>
      <a href={withBase('risorse/')}>Risorse</a>
      <a href={withBase('rss.xml')}>RSS</a>
    </nav>
    <p class="footer-meta">© {year} Fantascienza e dintorni<br />Contenuti versionati e pubblicati staticamente.</p>
  </div>
</footer>
