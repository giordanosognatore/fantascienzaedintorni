---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HeroArticle from '../components/HeroArticle.astro';
import CommunityCTA from '../components/CommunityCTA.astro';
import AuthorCard from '../components/AuthorCard.astro';
import { publishedPosts } from '../utils/content';
import { categoryId, withBase } from '../utils/urls';

const posts = publishedPosts(await getCollection('blog'));
const authors = await getCollection('authors');
const featured = posts.find((post) => post.data.featured);
const latest = posts.filter((post) => post.id !== featured?.id).slice(0, 3);
const primaryAuthor = authors.find((author) => author.data.slug === 'giordano-sognatore') ?? authors[0];

const topicEntrances = [
  {
    title: 'Libri',
    label: 'Narrazioni',
    description: 'Recensioni, classici, nuove voci e percorsi di lettura.',
    category: 'Libri',
  },
  {
    title: 'Cinema',
    label: 'Visioni',
    description: 'Film, autori e adattamenti che immaginano altri mondi.',
    category: 'Cinema',
  },
  {
    title: 'Serie TV',
    label: 'Universi',
    description: 'Storie seriali, episodi e mondi che crescono nel tempo.',
    category: 'Serie TV',
  },
  {
    title: 'Videogames',
    label: 'Esperienze',
    description: 'Mondi interattivi, game design e futuri da esplorare.',
    category: 'Videogames',
  },
];
---

<BaseLayout
  title="Fantascienza e dintorni"
  description="Magazine indipendente dedicato a libri, cinema, serie TV, videogames, scienza e immaginari del futuro."
>
  <section class="home-hero wrap">
    <div class="home-hero-copy">
      <p class="eyebrow">Magazine · Community · Archivio</p>
      <h1>La fantascienza è una <span>conversazione</span>.</h1>
      <p class="hero-lead">
        Storie, idee e futuri possibili da leggere, guardare e attraversare. Fantascienza e dintorni è uno spazio editoriale indipendente aperto alle molte forme dell'immaginario.
      </p>
      <div class="hero-actions">
        <a class="button" href={withBase('blog/')}>
          Esplora il magazine <span aria-hidden="true">→</span>
        </a>
        <a class="button button-secondary" href={withBase('community/')}>Scopri il progetto</a>
      </div>
    </div>
    <div class="hero-manifesto" aria-label="Manifesto di Fantascienza e dintorni">
      <span class="manifesto-number">01</span>
      <p>Le storie accendono le idee.</p>
      <span class="manifesto-line"></span>
      <p>La cura editoriale crea percorsi.</p>
      <span class="manifesto-line"></span>
      <p>L'archivio li apre a nuovi lettori.</p>
    </div>
  </section>

  <section class="wrap section-block" aria-labelledby="evidenza-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Primo segnale</p>
        <h2 id="evidenza-title">In evidenza</h2>
      </div>
      <a class="section-link" href={withBase('blog/')}>Tutti gli articoli <span aria-hidden="true">→</span></a>
    </div>
    {featured ? (
      <HeroArticle post={featured} />
    ) : (
      <div class="empty-state">
        <p>Il primo articolo è in preparazione.</p>
        <a class="read-link" href={withBase('blog/')}>Esplora le sezioni del magazine <span aria-hidden="true">→</span></a>
      </div>
    )}
  </section>

  <section class="wrap section-block" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Ultime coordinate</p>
        <h2 id="latest-title">Ultimi articoli</h2>
      </div>
    </div>
    {latest.length > 0 ? (
      <div class="article-grid">
        {latest.map((post) => <ArticleCard post={post} />)}
      </div>
    ) : (
      <div class="empty-state empty-state-inline">
        <p>Nuovi articoli arriveranno qui. Il magazine è pronto ad accoglierli.</p>
      </div>
    )}
  </section>

  <section class="community-pulse">
    <div class="wrap community-pulse-grid">
      <div>
        <p class="eyebrow">Dietro le quinte</p>
        <h2>Una community<br />da costruire insieme</h2>
      </div>
      <div class="community-pulse-copy">
        <p class="pulse-status">Spazio in preparazione</p>
        <p>
          Il progetto crescerà anche attraverso occasioni di confronto tra lettrici, lettori, spettatori e giocatori. I canali ufficiali saranno annunciati soltanto quando saranno pronti e verificati.
        </p>
        <a class="read-link" href={withBase('community/')}>Scopri la visione della community <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="wrap section-block" aria-labelledby="routes-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Rotte di esplorazione</p>
        <h2 id="routes-title">Scegli da dove partire</h2>
      </div>
    </div>
    <div class="topic-grid">
      {topicEntrances.map((topic, index) => (
        <a class="topic-card" href={`${withBase('blog/')}#${categoryId(topic.category)}`}>
          <span class="topic-index">0{index + 1}</span>
          <span class="eyebrow">{topic.label}</span>
          <strong>{topic.title}</strong>
          <span>{topic.description}</span>
          <span class="topic-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  {primaryAuthor && (
    <section class="wrap section-block" aria-labelledby="voices-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Voci dal progetto</p>
          <h2 id="voices-title">Gli autori</h2>
        </div>
        <a class="section-link" href={withBase('autori/')}>Tutti gli autori <span aria-hidden="true">→</span></a>
      </div>
      <AuthorCard author={primaryAuthor} />
    </section>
  )}

  <section class="wrap section-block section-last">
    <CommunityCTA />
  </section>
</BaseLayout>
